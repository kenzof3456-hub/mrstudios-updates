# Discord (required)
DISCORD_TOKEN=your_discord_bot_token

# Optional: register slash commands in one server instantly.
# If omitted, commands are registered globally (can take a few minutes).
DISCORD_GUILD_ID=

# Optional: only members with this role can use /start and /stop.
DISCORD_ALLOWED_ROLE_ID=

# Aternos (required) — never commit real values
ATERNOS_USERNAME=your_aternos_username
ATERNOS_PASSWORD=your_aternos_password

# Optional if the account has more than one server
ATERNOS_SERVER_ID=
ATERNOS_SERVER_NAME=

# Optional: full path to Chromium/Chrome if `chromium` is not on PATH
CHROMIUM_PATH=
