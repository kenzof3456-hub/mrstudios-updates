# OpenAI-compatible API (optional — intents, search, clock, apps, Edge/SAPI TTS work without it)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
# British male style-match (not an actor clone). Default is fable if this is unset.
OPENAI_TTS_VOICE=fable
OPENAI_VISION_MODEL=gpt-4o-mini
# Whisper STT (same key). Electron records the mic and sends audio; no Chromium SpeechRecognition required.

